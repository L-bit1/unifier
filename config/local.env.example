# 个人/团队本地覆盖（复制为 local.env，勿提交）
# 路径：config/local.env
# 加载顺序：hub/.env → config/local.env（后者覆盖前者）

# --- 设备与联通性 ---
# 本机设备 ID（每台机器不同，建议 hostname 或自命名）
# UNIFIER_DEVICE_ID=my-mac
# UNIFIER_AGENT_ID=cursor

# 期望在线的设备（逗号分隔；留空则不强制联通性门禁）
# UNIFIER_EXPECTED_DEVICES=device-a,device-b

# --- 本地项目扫描（飞书「项目」卡片）---
# 逗号分隔，扫描其下含 .git 的子目录并映射 GitHub remote（路径含空格请加引号）
# UNIFIER_WORKSPACE_ROOTS="/path/with spaces/projects"

# --- 飞书派活默认（可选；也可在飞书里「选项目」）---
# FEISHU_DEFAULT_GITHUB_OWNER=your-org
# FEISHU_DEFAULT_GITHUB_REPO=your-repo
# FEISHU_DEFAULT_IMPLEMENTER_DEVICE=device-a
# FEISHU_DEFAULT_IMPLEMENTER_AGENT=cursor
# FEISHU_DEFAULT_REVIEWERS=device-b:cursor,device-b:trae,device-a:trae
