# 复制为 .env 后按需修改（勿提交 .env）
# 个人路径、设备名请写在仓库根目录 config/local.env（见 INSTALL.md）

# 监听地址：其他设备要能访问 Hub 所在机器的 IP
UNIFIER_HOST=0.0.0.0
UNIFIER_PORT=8787

# SQLite 数据库路径（相对 hub 目录）
UNIFIER_DB=data/unifier.db

# 设备多久内有心跳视为在线（秒）
UNIFIER_DEVICE_ONLINE_SECONDS=90

# 联通性检查期望在线的设备（逗号分隔；留空则不强制门禁）
# UNIFIER_EXPECTED_DEVICES=device-a,device-b

# 飞书自建应用（必填，若使用飞书 Bot）
# FEISHU_APP_ID=cli_xxxx
# FEISHU_APP_SECRET=xxxx

# 飞书派活默认（可选；推荐在群里「选项目」）
# FEISHU_DEFAULT_GITHUB_OWNER=your-org
# FEISHU_DEFAULT_GITHUB_REPO=your-repo
# FEISHU_DEFAULT_IMPLEMENTER_DEVICE=device-a
# FEISHU_DEFAULT_IMPLEMENTER_AGENT=cursor
# FEISHU_DEFAULT_REVIEWERS=device-b:cursor,device-b:trae,device-a:trae

# 可选：GitHub PAT（repo 只读），拉取仓库列表
# GITHUB_TOKEN=ghp_xxxx

# 本地 Git 项目扫描目录（也可写在 config/local.env）
# UNIFIER_WORKSPACE_ROOTS=/path/to/your/projects
